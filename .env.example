APP_NAME=FireOps Intelligence
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@localhost:5432/fireassets
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
#google Oauth configuration
GOOGLE_CLIENT_SECRET=YOUR-SECRET-KEY-HERE
GOOGLE_CLIENT_ID=YOUR-CLIENT-ID-HERE
GOOGLE_REDIRECT_URI=YOUR-URL-REDIRECT-GOOGLE-CLOUD
# Public app origin used for registration/review emails (no path, query, or secret).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Gmail API sender: authorize gmail.send separately; never commit real values.
GMAIL_SENDER_EMAIL=
GMAIL_REFRESH_TOKEN=
REGISTRATION_ADMIN_EMAIL=
