# ==============================================================================
# deploy/postgres/.env.example
# Plantilla de variables de entorno para PostgreSQL 18 en VPS
#
# INSTRUCCIONES DE SEGURIDAD:
# 1. Copiar este archivo como .env en el VPS: cp .env.example .env
# 2. Generar contraseñas criptográficas con: openssl rand -hex 24
# 3. Asignar permisos estrictos de solo lectura al propietario: chmod 600 .env
# 4. NUNCA comitear el archivo .env real al repositorio.
# ==============================================================================

# Superusuario administrativo del motor (distinto del usuario de aplicación)
POSTGRES_SUPERUSER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_GENERATE_RANDOM_HEX_24
POSTGRES_INIT_DB=postgres

# Usuario de aplicación sin privilegios de superusuario (usado por backend BOMBEROS)
FIREOPS_APP_USER=fireops_app
FIREOPS_APP_PASSWORD=CHANGE_ME_GENERATE_RANDOM_HEX_24
FIREOPS_APP_DB=fireassets
