# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml

# Type checking and linting caches
.mypy_cache/
.ruff_cache/
.pyright/
.dmypy.json
dmypy.json

# Build and packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Local databases and temporary files
*.sqlite
*.sqlite3
*.db
tmp/
temp/

# Alembic temporary files
alembic.ini.bak

# Local Alembic practice migrations
# During class, participants generate their own migration files.
# The instructor will decide which migration becomes official.
# Add the official migration explicitly with: git add -f migrations/versions/<file>.py
migrations/versions/*.py

# Uploaded or generated local files
uploads/
storage/
artifacts/

# Optional local configuration
config.local.*
settings.local.*

# Keep empty directories when needed
!.gitkeep